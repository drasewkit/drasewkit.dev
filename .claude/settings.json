{
  "permissions": {
    "ask": [
      "Bash(*npm* run* deploy*)",
      "Bash(*wrangler* deploy*)",
      "Bash(*wrangler* versions*)",
      "Bash(*wrangler* rollback*)",
      "Bash(*wrangler* delete*)",
      "Bash(*wrangler* secret*)"
    ],
    "deny": [
      "Read(//**/.dev.vars*)",
      "Read(//**/.env*)",
      "Bash(*.dev.vars*)",
      "Edit(//**/worker-configuration.d.ts)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh"
          }
        ]
      }
    ]
  }
}
